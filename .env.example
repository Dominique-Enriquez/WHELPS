# Runtime: use Supabase's transaction pooler (port 6543) for serverless deployments.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres
DATABASE_POOL_SIZE=3

# Admin bootstrap (run `npm run provision-admin` after migrating).
WHELPS_ADMIN_NAME=Whelps Administrator
WHELPS_ADMIN_EMAIL=admin@example.com
WHELPS_ADMIN_PASSWORD=replace-with-at-least-12-characters
